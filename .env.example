# data-plane environment.
#
# Copy to .env and fill in the secret. QDRANT_API_KEY has no default and
# the stack will refuse to start without it.

# ---- Shared ---------------------------------------------------------------

# Qdrant compose profile. Use 'cpu' (default) or 'cuda' for GPU-accelerated image.
PROFILE=cpu

# Name of the external network between the app backends and data-plane.
# Created via `make network`. Override only if you renamed it.
DATA_NET=data-net

# ---- Qdrant (consumed by docint) ------------------------------------------

# Required API key: the stack refuses to start without it. Generate one with
#   openssl rand -hex 32
# Every REST/gRPC call needs it as the `api-key` header, including the Qdrant
# dashboard reached over the admin SSH tunnel. docint must be given the SAME
# value as QDRANT_API_KEY in its own .env, and must be on a release that
# supports it (>= v2.5.0). Changing it: set both .env files, then make up here
# first, then in docint.
QDRANT_API_KEY=

# ---- Backups -----------------------------------------------------------------

# Backups are encrypted with age to the public keys in this file: one public
# key (age1...) per line, # comments allowed (backup/README.md: Encryption).
# Public keys only: the identity that decrypts stays offline. Unset, make uses
# backup/recipients.txt; while the file is missing, every backup refuses to run.
# BACKUP_RECIPIENTS=./backup/recipients.txt

# After every backup, that store's backups older than this many days are
# deleted (whole days from 1 to 365; backup/README.md: Retention). Keep the
# off-host copies no longer.
# BACKUP_RETENTION_DAYS=30
# A new period deletes nothing for this many days after it took effect; a
# changed one never deletes sooner than announced (whole days from 1 to 365;
# backup/README.md: Retention).
# RETENTION_NOTICE_DAYS=30

# ---- Audit trail (admin-audit) --------------------------------------------

# The actions whose records need a stated purpose (CASE_REF= / REASON= on the
# make targets; README: Audit trail). Backups are `disclose`, restores
# `modify`, the pruning of old backups `delete`. Left unset, the default is
# query,disclose: backups need a purpose, restores do not. Set it empty to
# require none. The database shell (make qdrant-shell) always needs one.
# AUDIT_REQUIRE_PURPOSE=query,disclose

# ---- Dev-only (only consumed when compose.override.yaml is layered on) --------

QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

# data-plane environment.
#
# Copy to .env and fill in the secrets. NEO4J_PASSWORD has no default and
# the stack will refuse to start without it.

# ---- Shared ---------------------------------------------------------------

# Qdrant compose profile. Use 'cpu' (default) or 'cuda' for GPU-accelerated image.
PROFILE=cpu

# Name of the external network between the app backends and data-plane.
# Created via `make network`. Override only if you renamed it.
DATA_NET=data-net

# ---- Neo4j (consumed by chorus) ------------------------------------------

NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-set-a-real-password

# Memory tuning — adjust to host capacity. Rule of thumb: heap_max ≈ 25% of
# RAM, pagecache ≈ 50% of RAM, leaving headroom for the OS.
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

# Plugins. Leave empty in airgap — NEO4J_PLUGINS pulls from the public CDN
# on first boot. Mirror plugin jars into the neo4j-plugins volume
# out-of-band instead.
NEO4J_PLUGINS=

# ---- Qdrant (consumed by docint) ------------------------------------------

# Optional API key. Leave the line COMMENTED OUT for no authentication (the
# current behaviour). Do NOT set it to an empty value: Qdrant reads an empty
# key as "auth on" and answers every request with 401.
#
# To enable, uncomment and set a long random value (openssl rand -hex 32).
# Every REST/gRPC call then needs the `api-key` header, including the Qdrant
# dashboard reached over the admin SSH tunnel. docint must be given the SAME
# value as QDRANT_API_KEY in its own .env, and must be on a release that
# supports it (>= v2.5.0). Bring data-plane up first, then docint.
# QDRANT__SERVICE__API_KEY=

# ---- Dev-only (only consumed when compose.override.yaml is layered on) --------

NEO4J_BOLT_HOST_PORT=7687
NEO4J_HTTP_HOST_PORT=7474
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
